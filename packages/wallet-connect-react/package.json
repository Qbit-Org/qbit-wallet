{
  "name": "@qbit/wallet-connect-react",
  "version": "0.2.3",
  "private": true,
  "description": "React components for Qbit wallet connections",
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*",
    "src/**/*",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "import": "./lib/index.mjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rm -rf lib",
    "dev": "tsup --watch",
    "prepublishOnly": "pnpm clean && pnpm test && pnpm build"
  },
  "keywords": [
    "qbit-chain",
    "wallet",
    "react",
    "web3",
    "qbit",
    "connect",
    "hooks",
    "provider",
    "typescript"
  ],
  "author": "Qbit Wallet Team",
  "license": "MIT",
  "dependencies": {
    "@qbit/wallet-connect": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "@types/react": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "eslint": "^8.50.0",
    "react": "^18.2.0",
    "tsup": "^7.2.0",
    "typescript": "^5.2.0",
    "vitest": "3.2.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Qbit-Org/qbit-wallet.git",
    "directory": "packages/wallet-connect-react"
  },
  "bugs": {
    "url": "https://github.com/Qbit-Org/qbit-wallet/issues"
  },
  "homepage": "https://github.com/Qbit-Org/qbit-wallet/tree/main/packages/wallet-connect-react#readme"
}
