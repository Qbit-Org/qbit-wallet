{
  "name": "@qbit/tx-helpers",
  "version": "1.2.8",
  "private": true,
  "description": "Transaction helpers for Qbit Wallet",
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*",
    "src/**/*",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "import": "./lib/index.mjs"
    },
    "./types": {
      "types": "./lib/types/index.d.ts",
      "require": "./lib/types/index.js",
      "import": "./lib/types/index.mjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.js",
    "clean": "rm -rf lib",
    "dev": "tsup --watch",
    "prepublishOnly": "pnpm clean && pnpm test && pnpm build"
  },
  "keywords": [
    "qbit",
    "transaction",
    "psbt",
    "wallet",
    "blockchain",
    "typescript"
  ],
  "author": "Qbit Wallet Team",
  "license": "MIT",
  "dependencies": {
    "@qbit/wallet-core": "workspace:*",
    "@qbit/wallet-types": "workspace:*",
    "@qbit/wallet-shared": "workspace:*",
    "@qbit/keyring-service": "workspace:*",
    "bignumber.js": "^9.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "eslint": "^8.50.0",
    "tsup": "^7.2.0",
    "typescript": "^5.2.0",
    "vitest": "3.2.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Qbit-Org/qbit-wallet.git",
    "directory": "packages/tx-helpers"
  },
  "bugs": {
    "url": "https://github.com/Qbit-Org/qbit-wallet/issues"
  },
  "homepage": "https://github.com/Qbit-Org/qbit-wallet/tree/main/packages/tx-helpers#readme"
}
