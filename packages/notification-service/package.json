{
  "name": "@qbit/notification-service",
  "version": "1.1.8",
  "private": true,
  "description": "Cross-platform permission management service for web3 applications",
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*",
    "src/**/*",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "import": "./lib/index.mjs"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "require": "./lib/types.js",
      "import": "./lib/types.mjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm clean && pnpm test && pnpm build"
  },
  "keywords": [
    "qbit",
    "permission",
    "web3",
    "wallet",
    "browser-extension",
    "dapp",
    "connected-sites"
  ],
  "author": "Qbit Wallet Team",
  "license": "MIT",
  "dependencies": {
    "eventemitter3": "^5.0.1",
    "@qbit/wallet-shared": "workspace:*",
    "@qbit/wallet-storage": "workspace:*",
    "@qbit/wallet-api": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^7.0.0",
    "typescript": "^5.0.0",
    "vitest": "3.2.6"
  }
}
