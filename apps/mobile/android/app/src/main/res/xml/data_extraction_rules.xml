<?xml version="1.0" encoding="utf-8"?>
<!--
  The wallet vault lives in SharedPreferences (@capacitor/preferences). It is
  encrypted with the wallet password, but must not leave the device in a
  cloud backup or a device-to-device transfer. Users restore from their
  recovery phrase instead.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
