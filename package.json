{
  "name": "@qbit/wallet-toolkit",
  "version": "0.1.0",
  "description": "Modular wallet toolkit for the Qbit network",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/extension"
  ],
  "scripts": {
    "build": "lerna run build --no-stream",
    "test": "pnpm -r test && corepack pnpm test:pqc-golden && corepack pnpm test:protocol-vectors",
    "lint": "node scripts/lint.mjs",
    "lint:workspaces": "corepack pnpm -r --no-bail --workspace-concurrency=1 --if-present --filter './packages/**' --filter './apps/**' run lint",
    "lint:repo": "node scripts/lint.mjs --repo-only",
    "clean": "pnpm -r clean",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm -r dev",
    "affected:packages": "node scripts/affected-packages.js",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "pqc:golden:write": "node experiments/pqc-wasm/scripts/write-slh-dsa-golden.mjs",
    "pqc:golden:prepare": "experiments/pqc-wasm/scripts/prepare-golden-upstream.sh",
    "pqc:golden:verify": "node experiments/pqc-wasm/scripts/verify-slh-dsa-golden.mjs",
    "pqc:golden:verify:committed": "node experiments/pqc-wasm/scripts/verify-slh-dsa-golden.mjs --committed-only",
    "pqc:browser:install": "corepack pnpm exec browsers install chrome@148.0.7778.97 --path .context/browsers",
    "sdk:packages:check": "node scripts/security/check-sdk-packages.mjs",
    "pqc:ci": "corepack pnpm pqc:golden:verify:committed && corepack pnpm sdk:packages:check && corepack pnpm test:pqc-golden && corepack pnpm --filter qbit-extension smoke:pqc-import",
    "test:pqc-golden": "node --test experiments/pqc-wasm/test/slh-dsa-golden.test.mjs scripts/conformance/pqc-package-vectors.test.mjs",
    "test:protocol-vectors": "node --test scripts/conformance/protocol-package-vectors.test.mjs",
    "test:extension-pqc-import": "corepack pnpm --filter qbit-extension smoke:pqc-import",
    "regtest:up": "bash scripts/regtest/up",
    "regtest:down": "bash scripts/regtest/down",
    "regtest:reset": "bash scripts/regtest/reset",
    "regtest:cli": "bash scripts/regtest/cli",
    "regtest:mine": "bash scripts/regtest/mine",
    "regtest:fund": "bash scripts/regtest/fund",
    "regtest:dump-descriptors": "bash scripts/regtest/dump-descriptors",
    "test:integration": "node scripts/conformance/smoke-regtest-harness.mjs",
    "test:integration:regtest-smoke": "node scripts/conformance/smoke-regtest-harness.mjs",
    "test:integration:qbit-api": "node scripts/conformance/qbit-api-regtest-smoke.mjs",
    "test:integration:public-explorer": "corepack pnpm --filter \"@qbit/wallet-shared...\" build && node scripts/conformance/public-explorer-fixture.mjs",
    "test:integration:p2mr-differential": "node scripts/conformance/p2mr-sighash-differential.mjs",
    "test:integration:send-flow": "corepack pnpm -r --if-present --filter './packages/**' --filter '!@qbit/wallet-background' run build && corepack pnpm --filter @qbit/wallet-background test:integration:send-flow",
    "test:e2e:prepare": "corepack pnpm -r --if-present --filter './packages/**' --filter '!@qbit/wallet-background' run build && corepack pnpm --filter @qbit/wallet-background run build",
    "test:e2e:build": "corepack pnpm test:e2e:prepare && corepack pnpm --filter qbit-extension build:chrome:mv3:e2e",
    "test:e2e:install-browser": "corepack pnpm exec playwright install chromium",
    "test:e2e": "corepack pnpm test:e2e:build && corepack pnpm exec playwright test",
    "test:e2e:headed": "corepack pnpm test:e2e:build && corepack pnpm exec playwright test --headed",
    "build:repro:extension": "node scripts/reproducible-extension-build.mjs",
    "security:dependencies": "node scripts/security/dependency-policy.mjs",
    "security:evidence": "node scripts/security/generate-dependency-evidence.mjs",
    "release:readiness": "node scripts/security/release-readiness.mjs",
    "test:security-adversarial": "bash scripts/security/run-adversarial-tests.sh",
    "test:security-tooling": "node --test scripts/security/*.test.mjs",
    "test:conformance": "node scripts/conformance/qbit-core-matrix.mjs",
    "test:conformance:offline": "node scripts/conformance/verify-p2mr-offline-fixture.mjs",
    "test:conformance:preflight": "node scripts/conformance/check-regtest-harness.mjs",
    "test:conformance:pin-report": "corepack pnpm --filter \"@qbit/wallet-shared...\" build && node --test scripts/conformance/*.test.mjs",
    "conformance:fixtures:matrix": "node scripts/conformance/generate-matrix-fixture.mjs",
    "conformance:fixtures:core": "node scripts/conformance/regenerate-core-fixtures.mjs",
    "conformance:fixtures:offline": "node scripts/conformance/generate-p2mr-offline-fixture.mjs",
    "conformance:pin-report": "node scripts/conformance/report-pin-diff.mjs"
  },
  "keywords": [
    "qbit",
    "wallet",
    "toolkit",
    "keyring",
    "p2mr",
    "pqc",
    "modular"
  ],
  "author": "Qbit Wallet Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Qbit-Org/qbit-wallet.git"
  },
  "bugs": {
    "url": "https://github.com/Qbit-Org/qbit-wallet/issues"
  },
  "homepage": "https://github.com/Qbit-Org/qbit-wallet#readme",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@changesets/cli": "^2.29.6",
    "@humanwhocodes/config-array": "^0.13.0",
    "@playwright/test": "1.61.1",
    "@puppeteer/browsers": "3.0.6",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "bitcoinjs-lib": "^6.1.6",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react-hooks": "^4.5.0",
    "lerna": "^9.0.7",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "tiny-secp256k1": "^2.2.1",
    "tsup": "^7.0.0",
    "typescript": "^5.0.0",
    "vitest": "3.2.6",
    "yaml": "2.8.1"
  },
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=8 <9"
  },
  "packageManager": "pnpm@8.6.0",
  "pnpm": {
    "overrides": {
      "@babel/plugin-transform-modules-systemjs": "7.29.4",
      "@babel/traverse": "7.29.0",
      "@isaacs/brace-expansion": "5.0.1",
      "@lerna/create@9>js-yaml": "4.3.2",
      "@lerna/create@9>minimatch": "3.1.5",
      "@nx/devkit": "22.7.9",
      "@nx/devkit@22>minimatch": "10.2.6",
      "@trivago/prettier-plugin-sort-imports@4>lodash": "4.18.1",
      "@vitest/coverage-v8": "3.2.6",
      "@vitest/ui": "3.2.6",
      "axios": "1.20.0",
      "brace-expansion": "5.0.11",
      "braces": "3.0.3",
      "browserslist": "4.28.7",
      "cosmiconfig@9>js-yaml": "4.3.2",
      "fast-uri": "3.1.7",
      "flatted": "3.4.2",
      "follow-redirects": "1.16.1",
      "handlebars": "4.7.10",
      "http-cache-semantics": "4.3.0",
      "immutable": "5.1.8",
      "ip-address": "10.3.1",
      "js-yaml@3": "3.15.2",
      "js-yaml@4": "4.3.2",
      "json-schema": "0.4.0",
      "lerna@9>js-yaml": "4.3.2",
      "lerna@9>minimatch": "3.1.5",
      "lodash": "4.18.1",
      "multimatch@5>minimatch": "3.1.5",
      "node-forge": "1.4.0",
      "nx": "22.7.9",
      "nx@22>minimatch": "10.2.6",
      "pacote": "21.5.1",
      "path-to-regexp": "0.1.13",
      "probe-image-size": "7.4.0",
      "react-redux": "^8.0.5",
      "serialize-javascript": "7.0.3",
      "shell-quote": "1.11.0",
      "sigstore": "4.1.1",
      "smol-toml": "1.7.1",
      "source-map-js": "1.2.2",
      "svgo@3": "3.3.5",
      "svgo@4": "4.1.0",
      "tar": "7.5.22",
      "tinypool": "2.1.2",
      "vinyl-contents@2>bl": "4.1.0",
      "vite": "6.4.4",
      "vitest": "3.2.6",
      "websocket-driver": "0.7.5"
    },
    "patchedDependencies": {
      "bitcore-lib@10.0.0": "patches/bitcore-lib@10.0.0.patch",
      "tiny-secp256k1@2.2.3": "patches/tiny-secp256k1@2.2.3.patch",
      "bitcoinjs-lib@6.1.6": "patches/bitcoinjs-lib@6.1.6.patch"
    }
  }
}
